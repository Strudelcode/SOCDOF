{
  "appId": "de.strudelcode.socdof",
  "productName": "SOCDOF",
  "copyright": "Copyright © 2026 Strudelcode - Yuri / Strudel",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*",
    "languages/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "languages",
      "to": "languages",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "icon": "public/socdof_icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SOCDOF Desktop",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "public/socdof_icon.ico",
    "uninstallerIcon": "public/socdof_icon.ico",
    "installerHeaderIcon": "public/socdof_icon.ico",
    "uninstallerSidebar": "public/uninstallerSidebar.bmp",
    "installerSidebar": "public/installerSidebar.bmp",
    "installerHeader": "public/installerHeader.bmp",
    "displayLanguageSelector": false
  }
}
