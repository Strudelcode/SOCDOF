{
  "appId": "de.strudelcode.socdof",
  "productName": "SOCDOF",
  "copyright": "Copyright © 2026 Strudelcode - Yuri / Strudel",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*",
    "package.json"
  ],
  "win": {
    "icon": "public/socdof_icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SOCDOF Desktop",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "runAfterFinish": true
  }
}
