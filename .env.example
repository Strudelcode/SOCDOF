# SOCDOF Environment Variables Template
# Copy this file to .env and configure your secret tokens locally.
# DO NOT commit .env to GitHub (gitignored).

# Discord Bot Token (used by Bug-Reports & Feedback forum integration and live status)
# Required for sending forum threads and reading real-time bot status / tags.
VITE_DISCORD_BOT_TOKEN=""

# Discord Webhook URL (optional, used by GitHub Actions release broadcast workflow)
# DISCORD_WEBHOOK="https://discord.com/api/webhooks/..."
